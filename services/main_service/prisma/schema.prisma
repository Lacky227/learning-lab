// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  age       Int?
  tasks     Task[]
}

model Task {
  id          Int      @id @default(autoincrement())
  taskId      String   @unique
  title       String
  description String?
  priority    Priority     @default(MEDIUM) // LOW, MEDIUM, HIGH
  category    Category     @default(GENERAL)  // TASK, WORK, FEATURE, BUG, GENERAL
  status      Status   @default(TO_DO) // e.g., TO_DO, IN_PROGRESS, COMPLETED
  isDone      Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Category {
  TASK
  WORK
  FEATURE
  BUG
  GENERAL
}
enum Status {
  TO_DO
  IN_PROGRESS
  COMPLETED
}